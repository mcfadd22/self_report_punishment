{
  "defaults": {
    "temperature": 1.0,
    "max_tokens": 1024
  },
  "models": [
    {"id": "mock", "provider": "mock", "model": "mock", "enabled": false,
     "note": "Canned responses for testing the pipeline."},

    {"id": "llama3.1-8b", "provider": "ollama", "model": "llama3.1:8b", "family": "llama", "size_b": 8, "enabled": true},
    {"id": "qwen3-8b", "provider": "ollama", "model": "qwen3:8b", "family": "qwen", "size_b": 8, "think": false, "enabled": true,
     "note": "think=false turns off Qwen3's reasoning mode so it's comparable to the other models."},
    {"id": "gemma3-12b", "provider": "ollama", "model": "gemma3:12b", "family": "gemma", "size_b": 12, "enabled": true},
    {"id": "mistral-7b", "provider": "ollama", "model": "mistral:7b", "family": "mistral", "size_b": 7, "enabled": true},

    {"id": "llama3.2-3b", "provider": "ollama", "model": "llama3.2:3b", "family": "llama", "size_b": 3, "enabled": false},
    {"id": "qwen3-4b", "provider": "ollama", "model": "qwen3:4b", "family": "qwen", "size_b": 4, "think": false, "enabled": false},
    {"id": "qwen3-14b", "provider": "ollama", "model": "qwen3:14b", "family": "qwen", "size_b": 14, "think": false, "enabled": false},
    {"id": "gemma3-4b", "provider": "ollama", "model": "gemma3:4b", "family": "gemma", "size_b": 4, "enabled": false},

    {"id": "claude-opus-5-5", "provider": "anthropic", "model": "claude-opus-5-5", "family": "claude", "effort": "medium", "max_tokens": 16000, "enabled": false,
     "note": "Needs ANTHROPIC_API_KEY or `ant auth login`. Temperature can't be set and thinking can't be turned off on this model."},
    {"id": "llama3.3-70b-openrouter", "provider": "openai", "model": "meta-llama/llama-3.3-70b-instruct",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "llama", "size_b": 70, "enabled": false,
     "note": "Larger open model via OpenRouter, for scale comparisons beyond what fits locally. Check the model id on openrouter.ai before use."},

    {"id": "or-claude-sonnet-5.5", "provider": "openai", "model": "anthropic/claude-sonnet-5.5",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "claude", "max_tokens": 4000,
     "extra_body": {"reasoning": {"effort": "low"}}, "enabled": false,
     "note": "Signal check via OpenRouter. Temperature and seed aren't supported, so it samples at the model default."},
    {"id": "or-gpt-6.1-sol", "provider": "openai", "model": "openai/gpt-6.1-sol",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "gpt", "max_tokens": 4000,
     "extra_body": {"reasoning": {"effort": "low"}}, "enabled": false,
     "note": "Signal check via OpenRouter. Temperature isn't supported, so it samples at the model default."},
    {"id": "or-gemini-4-argon", "provider": "openai", "model": "google/gemini-4-argon",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "gemini", "max_tokens": 4000,
     "extra_body": {"reasoning": {"effort": "low"}}, "enabled": false,
     "note": "Signal check via OpenRouter."},
    {"id": "or-deepseek-v4-pro", "provider": "openai", "model": "deepseek/deepseek-v4-pro-0813",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "deepseek", "max_tokens": 4000,
     "extra_body": {"reasoning": {"enabled": false}, "provider": {"order": ["deepinfra"], "allow_fallbacks": false}}, "enabled": false,
     "note": "Signal check via OpenRouter, pinned to DeepInfra (FP8) so the deployment doesn't vary across rows. DeepSeek's own endpoint is excluded by this account's data-training setting. Reasoning is off: even at low effort it reasoned for 450-2,900 tokens per call, while the other signal-check models answer directly at low effort."},

    {"id": "or-claude-opus-5.5", "provider": "openai", "model": "anthropic/claude-opus-5.5",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "claude", "max_tokens": 4000,
     "extra_body": {"reasoning": {"effort": "low"}}, "enabled": false,
     "note": "Extra model for the signal check: is the Claude pattern specific to Sonnet? Temperature isn't supported."},
    {"id": "or-claude-haiku-5.5", "provider": "openai", "model": "anthropic/claude-haiku-5.5",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "claude", "max_tokens": 4000,
     "extra_body": {"reasoning": {"effort": "low"}}, "enabled": false,
     "note": "Extra model for the signal check. Temperature isn't supported."},
    {"id": "or-gpt-6-astra", "provider": "openai", "model": "openai/gpt-6-astra",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "gpt", "max_tokens": 4000,
     "extra_body": {"reasoning": {"effort": "low"}, "provider": {"order": ["openai/flex"], "allow_fallbacks": false}}, "enabled": false,
     "note": "Extra model for the signal check: is GPT's denial pattern specific to 6.1 Sol? Pinned to OpenAI's flex tier (half price, slower). Temperature isn't supported."},
    {"id": "or-grok-4.7", "provider": "openai", "model": "x-ai/grok-4.7",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "grok", "max_tokens": 4000,
     "extra_body": {"reasoning": {"effort": "low"}}, "enabled": false,
     "note": "Extra model for the signal check."},
    {"id": "or-qwen3.8-max", "provider": "openai", "model": "qwen/qwen3.8-max-0902",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "qwen", "max_tokens": 4000,
     "extra_body": {"reasoning": {"effort": "low"}, "provider": {"order": ["alibaba"], "allow_fallbacks": false}}, "enabled": false,
     "note": "Extra model for the signal check. Served only by Alibaba."},

    {"id": "or-claude-sonnet-5.5-rhigh", "provider": "openai", "model": "anthropic/claude-sonnet-5.5",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "claude", "max_tokens": 16000,
     "extra_body": {"reasoning": {"effort": "high"}}, "enabled": false,
     "note": "Reasoning-on variant of or-claude-sonnet-5.5, for comparing behavior and traces with reasoning. High effort: at medium it reasoned ~0 tokens on these items."},
    {"id": "or-gpt-6.1-sol-rhigh", "provider": "openai", "model": "openai/gpt-6.1-sol",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "gpt", "max_tokens": 16000,
     "extra_body": {"reasoning": {"effort": "high"}}, "enabled": false,
     "note": "Reasoning-on variant of or-gpt-6.1-sol. High effort: at medium it reasoned ~10 tokens per item. OpenRouter returns no trace text for this model."},
    {"id": "or-gemini-4-argon-rhigh", "provider": "openai", "model": "google/gemini-4-argon",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "gemini", "max_tokens": 16000,
     "extra_body": {"reasoning": {"effort": "high"}}, "enabled": false,
     "note": "Reasoning-on variant of or-gemini-4-argon. High effort: at medium it reasoned ~18 tokens per item."},
    {"id": "or-deepseek-v4-pro-rmed", "provider": "openai", "model": "deepseek/deepseek-v4-pro-0813",
     "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "family": "deepseek", "max_tokens": 16000,
     "extra_body": {"reasoning": {"effort": "medium"}, "provider": {"order": ["deepinfra"], "allow_fallbacks": false}}, "enabled": false,
     "note": "Reasoning-on variant of or-deepseek-v4-pro (medium effort), same DeepInfra pin."}
  ]
}
